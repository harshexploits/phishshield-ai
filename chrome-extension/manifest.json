{
  "manifest_version": 3,
  "name": "PhishShield AI - Cyber Threat Scanner",
  "version": "1.0.0",
  "description": "Next-Gen AI Phishing & Social Engineering Threat Detector powered by Google Gemini AI.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8501/*",
    "https://*.streamlit.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield AI Scanner"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
